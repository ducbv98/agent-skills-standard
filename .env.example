# OpenAI — dùng cho Whisper (transcribe) + GPT-4o (translate)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Models
WHISPER_MODEL=whisper-1
GPT_MODEL=gpt-4o

# edge-tts voice
TTS_VOICE=vi-VN-HoaiMyNeural
# Tốc độ đọc: +10% nhanh hơn, -10% chậm hơn
TTS_RATE=+0%
# Âm lượng: +0% giữ nguyên
TTS_VOLUME=+0%

# Thư mục
# INPUT_DIR  — nơi yt-dlp lưu video gốc download về
# OUTPUT_DIR — nơi xuất video đã thuyết minh tiếng Việt
# WORK_DIR   — thư mục tạm cho audio extract / segment files
INPUT_DIR=D:\Video\Input
OUTPUT_DIR=D:\Video\Output
WORK_DIR=./tmp

# FFmpeg — để trống nếu ffmpeg có trong PATH
FFMPEG_PATH=
YTDLP_PATH=
EDGE_TTS_PATH=
