# AWS credentials — dùng IAM role (recommended) hoặc access key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=       # optional, chỉ cần khi dùng STS assume role
AWS_REGION=ap-southeast-1

# Giới hạn an toàn
# Chỉ cho phép operations trên các resource có prefix này (để trống = không giới hạn)
AWS_ALLOWED_BUCKET_PREFIX=
AWS_READONLY=false       # true = chặn tất cả write operations
