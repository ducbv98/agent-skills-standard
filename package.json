{
  "name": "viet-dubber",
  "version": "1.0.0",
  "private": true,
  "description": "Auto-download Chinese video → Vietnamese AI dubbing pipeline",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @viet-dubber/pipeline dev",
    "dub": "pnpm --filter @viet-dubber/pipeline start",
    "web": "pnpm --filter @viet-dubber/web dev",
    "web:start": "pnpm --filter @viet-dubber/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "typescript": "^5.9.3",
    "prettier": "^3.4.2",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "typescript-eslint": "^8.20.0"
  }
}
