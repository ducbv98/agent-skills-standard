{
  "mcpServers": {
    "context7": {
      "command": "cmd",
      "args": [
        "/c",
        "D:\\agent-skills-standard\\packages\\mcp-context7\\run.cmd"
      ],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "password",
        "QDRANT_URL": "http://localhost:6333",
        "QDRANT_COLLECTION": "hybrid_rag",
        "OPENAI_API_KEY": "",
        "EMBEDDING_MODEL": "text-embedding-3-small",
        "EMBEDDING_DIMENSIONS": "1536",
        "CAG_ENABLED": "true",
        "CAG_TOKEN_THRESHOLD": "32000"
      },
      "disabled": false,
      "autoApprove": ["search_context", "list_modes"]
    },
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "D:\\agent-skills-standard\\packages\\mcp-playwright\\run.cmd"
      ],
      "env": {
        "PLAYWRIGHT_HEADLESS": "true",
        "PLAYWRIGHT_BROWSER": "chromium"
      },
      "disabled": false,
      "autoApprove": ["navigate", "screenshot", "get_text", "get_html", "scroll", "wait_for"]
    }
  }
}
